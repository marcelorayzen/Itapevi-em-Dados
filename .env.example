# Opcional: Chave do Tavily para buscas avançadas
# TAVILY_API_KEY=sua-chave-aqui

# Porta usada por src/app.ts quando o adaptador HTTP é iniciado explicitamente.
# O comando npm start usa o transporte MCP via stdio.
PORT=3000

# PostgreSQL local de desenvolvimento. Não reutilize esta senha em ambientes reais.
POSTGRES_PASSWORD=itapevi_dev_only
DATABASE_URL=postgresql://itapevi:itapevi_dev_only@localhost:55433/itapevi_em_dados
