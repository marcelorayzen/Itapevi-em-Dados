{
  "name": "itapevi-em-dados-public-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api-dados.rayzen.com.br",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f274ae5ca9ba4482a40b50a6ab5b4efb"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_QUERY_RATE_LIMITER",
      "namespace_id": "3522505",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "itapevi_em_dados_public_api"
    }
  ],
  "vars": {
    "AI_PILOT_ENABLED": "false",
    "RATE_LIMIT_ENABLED": "true",
    "TURNSTILE_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFudgJvfL-D8dC2t"
  }
}

