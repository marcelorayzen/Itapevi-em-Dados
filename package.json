{
  "name": "itapevi-em-dados",
  "version": "0.1.0",
  "description": "Servidor MCP com dados públicos de Itapevi",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "health:start": "tsx scripts/start-health.ts",
    "demo:start": "tsx scripts/start-health.ts",
    "download:dados": "tsx scripts/download-dados-municipio.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:bootstrap:f1": "tsx scripts/bootstrap-f1-catalog.ts",
    "db:register-artifact": "tsx scripts/register-artifact.ts",
    "db:persist-loa-candidate": "tsx scripts/persist-loa-candidate.ts",
    "db:bootstrap-loa-entities": "tsx scripts/bootstrap-loa-org-entities.ts",
    "db:bootstrap:lai": "tsx scripts/bootstrap-lai-catalog.ts",
    "db:bootstrap:lai-procurement": "tsx scripts/bootstrap-lai-procurement-catalog.ts",
    "db:bootstrap:ibge": "tsx scripts/bootstrap-ibge-catalog.ts",
    "db:bootstrap:tcesp": "tsx scripts/bootstrap-tcesp-catalog.ts",
    "db:ingest:lai": "tsx scripts/ingest-lai-export.ts",
    "db:ingest:lai-procurement": "tsx scripts/ingest-lai-procurement-export.ts",
    "db:ingest:ibge": "tsx scripts/ingest-ibge-estimate.ts",
    "db:ingest:tcesp": "tsx scripts/ingest-tcesp-aggregate.ts",
    "db:inspect:f2": "tsx scripts/inspect-entity-evidence.ts",
    "db:catalog": "tsx scripts/inspect-dataset-catalog.ts",
    "alerts:weekly": "tsx scripts/weekly-alert-report.ts",
    "normalize:loa": "tsx scripts/normalize-loa.ts",
    "test": "jest --runInBand"
  },
  "keywords": [
    "mcp",
    "itapevi",
    "dados-abertos",
    "transparencia"
  ],
  "author": "Marcelo Augusto / Rayzen Gov",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/unzipper": "^0.10.11",
    "axios": "^1.21.0",
    "cheerio": "^1.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "pg": "^8.23.1",
    "unzipper": "^0.12.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "axios-mock-adapter": "^2.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
